Screen {
    layout: vertical;
}

#title-bar {
    height: 1;
    background: $primary;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

#main {
    layout: horizontal;
    height: 1fr;
}

ProcessOutput {
    width: 1fr;
    border: round $secondary;
    padding: 0 1;
}

#side {
    width: 42;
    layout: vertical;
}

MetricsPanel {
    height: 1fr;
    border: round $success;
    padding: 0 1;
}

SummaryPanel {
    height: auto;
    border: round $warning;
    padding: 0 1;
    display: none;
}

SummaryPanel.visible {
    display: block;
}

/* Dashboard */
#sessions-table {
    height: 1fr;
}

#sessions-footer {
    height: auto;
    border-top: solid $secondary;
    padding: 0 1;
}

.compare-block {
    height: auto;
    padding: 1;
    border: round $secondary;
    margin-bottom: 1;
}

.timeline-label {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

Sparkline {
    height: 3;
    margin: 0 1 1 1;
}
